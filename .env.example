# Copy to .env only if you want to change a default. Every variable below has
# a working default in docker-compose.yml, so the stack runs with no .env at
# all. There are no secrets left in this stack.

# --- Ollama runtime -------------------------------------------------------
# How long a model stays resident after its last request.
OLLAMA_KEEP_ALIVE=30m
# Context window offered to models. Larger costs VRAM you may not have.
OLLAMA_CONTEXT_LENGTH=16384
# One model, one request at a time. On a single consumer GPU, concurrency
# trades latency for nothing. Raise deliberately.
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1

# --- Ports and bind addresses ---------------------------------------------
# Everything binds to localhost. Point a *_BIND_ADDRESS at a Tailscale or
# trusted-LAN address only when remote access is actually intended -- and turn
# WEBUI_AUTH on first.
OLLAMA_BIND_ADDRESS=127.0.0.1
OLLAMA_HOST_PORT=11435
WEBUI_BIND_ADDRESS=127.0.0.1
WEBUI_HOST_PORT=8080
GRAFANA_BIND_ADDRESS=127.0.0.1
GRAFANA_HOST_PORT=3000
PROMETHEUS_BIND_ADDRESS=127.0.0.1
PROMETHEUS_HOST_PORT=9090
DOZZLE_BIND_ADDRESS=127.0.0.1
DOZZLE_HOST_PORT=9999

# --- Open WebUI -----------------------------------------------------------
# Off by operator decision for a single-user localhost box. Set to true before
# exposing port 8080 anywhere.
WEBUI_AUTH=false

# --- Metrics --------------------------------------------------------------
PROMETHEUS_RETENTION=15d
