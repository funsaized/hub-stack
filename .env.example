# Copy to .env and fill in. Defaults are dev-only.
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768
WORKER_LEASE_SECONDS=60
WORKER_HEARTBEAT_SECONDS=15
JOB_TIMEOUT_SECONDS=1800
JOB_MAX_ATTEMPTS=3
EMBEDDING_BATCH_SIZE=16
EMBEDDING_BATCH_CHARS=12000
DEPENDENCY_MAX_ATTEMPTS=3
# Host interface for Ollama's published API. Keep localhost unless remote access
# is intentional; use a specific trusted LAN/Tailscale IP instead of 0.0.0.0.
OLLAMA_BIND_ADDRESS=127.0.0.1
# Docker Desktop's model runner commonly reserves host port 11434.
OLLAMA_HOST_PORT=11435
