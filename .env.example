# Copy to .env and fill in. Defaults are dev-only.
#
# --- Required secrets (compose refuses to start while these are empty) ---
# Generate each value with:  openssl rand -hex 32
# Never commit real values; .env is gitignored.
# SearXNG server secret (signs its own cookies/CSRF tokens).
SEARXNG_SECRET=
# Shared bearer token between research-hub/research-worker and the Crawl4AI API.
CRAWL4AI_API_TOKEN=
# MiniMax Token Plan Subscription Key (HUB-035 judge gate). Copy from the
# MiniMax platform account page; never commit the real value.
MINIMAX_SUBSCRIPTION_KEY=
# Optional (webui profile only): leave empty and Open WebUI generates a random
# key on first start, persisted in its data volume. Set only if sessions must
# survive a volume wipe.
WEBUI_SECRET_KEY=

EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768
LLM_MODEL=qwen3.5:9b
OLLAMA_KEEP_ALIVE=30m
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
WORKER_LEASE_SECONDS=60
WORKER_HEARTBEAT_SECONDS=15
JOB_TIMEOUT_SECONDS=1800
JOB_MAX_ATTEMPTS=3
EMBEDDING_BATCH_SIZE=16
EMBEDDING_BATCH_CHARS=12000
DEPENDENCY_MAX_ATTEMPTS=3
MODEL_CONTEXT_TOKENS=8192
ANSWER_RESERVE_TOKENS=2048
ALLOW_CUSTOM_SYSTEM_PROMPTS=false
RESPECT_ROBOTS_TXT=true
# Fetched documents larger than this are rejected (SSRF/resource guard).
CRAWL_MAX_MARKDOWN_CHARS=2000000
REPORT_RETRIEVAL_CANDIDATES=40
REPORT_MAX_CHUNKS_PER_SOURCE=3
# Disabled until retrieval evaluation establishes a justified threshold.
REPORT_RETRIEVAL_MIN_SCORE=
# Adaptive query planning (HUB-024, stage 1). Off until measured against the
# single-query baseline. Breadth is emergent: a candidate facet is admitted
# only while its cosine similarity to the admitted set stays below
# PLAN_FACET_DISTINCT, so a narrow topic collapses to exactly one search.
# PLAN_MAX_FACETS and the budgets are rails, not the breadth mechanism.
REPORT_QUERY_PLANNING=false
PLAN_FACET_DISTINCT=0.85
# The relevance half of the two-sided admission bar: a facet must be both
# distinct from the admitted set AND still about the topic. Permissive by
# design pending calibration -- every candidate's topic cosine is recorded
# in job provenance so this can be measured rather than guessed.
PLAN_FACET_RELEVANCE=0.35
PLAN_MAX_FACETS=8
# Rounds are gap-driven and stop when a round covers no additional facet.
# That rule needs no tuned threshold, so PLAN_NOVELTY_MIN is retired:
# document novelty could never fire as a stop signal, because admitting only
# distinct queries guarantees distinct documents. PLAN_MAX_ROUNDS is a backstop.
PLAN_MAX_ROUNDS=3
PLAN_SEARCH_BUDGET=12
PLAN_CRAWL_BUDGET=40
# Claim gate (HUB-034): the MiniMax M3 LLM-as-judge faithfulness gate,
# validated by the sealed v4 blind evaluation (2026-08-12). The NLI stack is
# retired. Judged evidence spans leave the machine for the MiniMax API.
JUDGE_BASE_URL=https://api.minimax.io/v1
JUDGE_MODEL=MiniMax-M3
JUDGE_TIMEOUT_SECONDS=60
# Host interface for Ollama's published API. Keep localhost unless remote access
# is intentional; use a specific trusted LAN/Tailscale IP instead of 0.0.0.0.
OLLAMA_BIND_ADDRESS=127.0.0.1
# Docker Desktop's model runner commonly reserves host port 11434.
OLLAMA_HOST_PORT=11435
