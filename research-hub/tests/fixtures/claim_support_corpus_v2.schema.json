{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://funsaized.local/schemas/claim-support-corpus-2.0.0.json",
  "title": "Claim-support evaluation corpus",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "corpus_id", "status", "policy", "coverage", "cases"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "corpus_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "frozen"]},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["support", "accept_label", "outside_knowledge"],
      "properties": {
        "support": {"type": "string", "minLength": 1},
        "accept_label": {"const": "entailment"},
        "outside_knowledge": {"const": false}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_categories"],
      "properties": {"required_categories": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}}
    },
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_index", "text"],
      "properties": {"evidence_index": {"type": "integer", "minimum": 0}, "text": {"type": "string", "minLength": 1}}
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "rationale", "material_components", "supporting_spans", "refuting_spans"],
      "properties": {
        "label": {"enum": ["entailment", "contradiction", "neutral"]},
        "rationale": {"type": "string", "minLength": 1},
        "material_components": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "supporting_spans": {"type": "array", "items": {"$ref": "#/$defs/span"}},
        "refuting_spans": {"type": "array", "items": {"$ref": "#/$defs/span"}},
        "relevant_spans": {"type": "array", "items": {"$ref": "#/$defs/span"}}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_id", "label", "rationale", "material_components", "supporting_spans", "refuting_spans"],
      "properties": {
        "reviewer_id": {"type": "string", "minLength": 1},
        "label": {"enum": ["entailment", "contradiction", "neutral"]},
        "rationale": {"type": "string", "minLength": 1},
        "material_components": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "supporting_spans": {"type": "array", "items": {"$ref": "#/$defs/span"}},
        "refuting_spans": {"type": "array", "items": {"$ref": "#/$defs/span"}},
        "relevant_spans": {"type": "array", "items": {"$ref": "#/$defs/span"}}
      }
    },
    "generatedEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prefix", "repeat", "count", "suffix"],
      "properties": {
        "prefix": {"type": "string"}, "repeat": {"type": "string"},
        "count": {"type": "integer", "minimum": 1, "maximum": 10000}, "suffix": {"type": "string"}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "partition", "status", "claim", "evidence", "categories", "critical", "phi"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "partition": {"enum": ["calibration", "final_blind", "critical_regression"]},
        "status": {"enum": ["draft", "adjudicated"]},
        "claim": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "minItems": 1, "items": {"oneOf": [{"type": "string", "minLength": 1}, {"$ref": "#/$defs/generatedEvidence"}]}},
        "categories": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "critical": {"type": "boolean"},
        "phi": {"const": false},
        "annotation": {"$ref": "#/$defs/annotation"},
        "reviews": {"type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/review"}}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "adjudicated"}}}, "then": {"required": ["annotation"]}},
        {"if": {"properties": {"partition": {"const": "final_blind"}, "status": {"const": "adjudicated"}}}, "then": {"required": ["reviews"], "properties": {"reviews": {"minItems": 2, "maxItems": 2}}}}
      ]
    }
  }
}
