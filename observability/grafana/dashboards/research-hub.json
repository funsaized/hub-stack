{
  "title": "Research Hub Pipeline",
  "uid": "research-hub",
  "schemaVersion": 39,
  "refresh": "15s",
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {"type":"timeseries","title":"HTTP request rate","gridPos":{"x":0,"y":0,"w":12,"h":8},"targets":[{"expr":"sum by (route, status) (rate(hub_http_requests_total[5m]))","legendFormat":"{{route}} {{status}}"}]},
    {"type":"timeseries","title":"Pipeline phase p95 latency","gridPos":{"x":12,"y":0,"w":12,"h":8},"targets":[{"expr":"histogram_quantile(0.95, sum by (le, phase) (rate(hub_job_phase_duration_seconds_bucket[15m])))","legendFormat":"{{phase}}"}]},
    {"type":"stat","title":"Failed jobs (24h)","gridPos":{"x":0,"y":8,"w":6,"h":5},"targets":[{"expr":"sum(increase(hub_jobs_total{outcome=\"failed\"}[24h]))"}]},
    {"type":"stat","title":"Crawl success rate","gridPos":{"x":6,"y":8,"w":6,"h":5},"targets":[{"expr":"sum(rate(hub_crawl_total{outcome=\"success\"}[15m])) / clamp_min(sum(rate(hub_crawl_total[15m])), 0.001)"}],"fieldConfig":{"defaults":{"unit":"percentunit"}}},
    {"type":"timeseries","title":"Embedding and upsert p95","gridPos":{"x":12,"y":8,"w":12,"h":5},"targets":[{"expr":"histogram_quantile(0.95, rate(hub_embedding_duration_seconds_bucket[15m]))","legendFormat":"embedding"},{"expr":"histogram_quantile(0.95, rate(hub_upsert_duration_seconds_bucket[15m]))","legendFormat":"upsert"}]},
    {"type":"timeseries","title":"Retrieval score distribution","gridPos":{"x":0,"y":13,"w":12,"h":7},"targets":[{"expr":"sum by (le) (rate(hub_retrieval_score_bucket[15m]))","legendFormat":"≤ {{le}}"}]},
    {"type":"timeseries","title":"Search results and chunks/source p50","gridPos":{"x":12,"y":13,"w":12,"h":7},"targets":[{"expr":"histogram_quantile(0.5, rate(hub_search_results_bucket[15m]))","legendFormat":"search results"},{"expr":"histogram_quantile(0.5, rate(hub_chunks_per_source_bucket[15m]))","legendFormat":"chunks/source"}]}
  ]
}
